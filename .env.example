# Fælles backend
PORT=8787
HOST=0.0.0.0
ALERT_LIFETIME_MINUTES=60
ALERT_DATA_FILE=data/alerts.json
ALLOWED_APP_ORIGINS=https://localhost,http://localhost:5173,http://127.0.0.1:5173

# Nummerpladeopslag
NUMMERPLADE_API_TOKEN=
NUMMERPLADE_API_TIMEOUT_MS=8000
NUMMERPLADE_CACHE_SECONDS=30

# Offentlig HTTPS-adresse til den fælles backend ved Android-build.
# Eksempel: https://api.ditdomæne.dk
VITE_API_BASE_URL=

# Valgfrit: appen bruger ellers det officielle Pladetjek-repository nedenfor.
VITE_UPDATE_REPOSITORY_URL=https://github.com/stralner2711-a11y/pladetjek
VITE_UPDATE_MANIFEST_URL=https://raw.githubusercontent.com/stralner2711-a11y/pladetjek/main/version.json
